



@model pr6.Models.Product

@{
    ViewData["Title"] = "Product Details";
}

<h1>Product Details</h1>

<div class="card">

    <div class="card-body">

        <h3>@Model.Name</h3>

        <hr />

        <p>
            <strong>Product ID:</strong>
            @Model.Id
        </p>

        <p>
            <strong>Description:</strong>
            @Model.Description
        </p>

        <p>
            <strong>Price:</strong>
            ₹@Model.Price
        </p>

        <p>
            <strong>Category:</strong>
            @Model.Category
        </p>

        <p>
            <strong>Stock:</strong>
            @Model.Stock
        </p>

        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-warning">
            Edit
        </a>

        <a asp-action="Index"
           class="btn btn-secondary">
            Back to Catalog
        </a>

    </div>

</div>